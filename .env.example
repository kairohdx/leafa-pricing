APP_ENV=development
# Optional: default is <repository>/data/leafa.db, regardless of working directory.
# DATABASE_URL=sqlite:///./data/leafa.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/leafa
DEMO_MODE=false
SESSION_HOURS=24
CORS_ORIGINS=["http://localhost:5173"]
# Docker: use a long URL-safe password (letters, digits, - and _).
# POSTGRES_PASSWORD=replace-with-a-generated-password
# API_PORT=8000
# FRONT_PORT=8080
# Optional explicit demo seed: also set DEMO_MODE=true.
# DEMO_PASSWORD=replace-with-at-least-12-characters
