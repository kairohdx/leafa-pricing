# Development uses Vite's proxy. No CORS configuration is needed in this mode.
VITE_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
# Render demo builds enable the disposable-data notice.
VITE_DEMO_MODE=false
# Production: VITE_API_URL must point to the public API (or a configured reverse proxy).
# Never place passwords, database URLs or private keys in VITE_* variables.
